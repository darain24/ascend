# Public application URL
# Local: http://localhost:3000
# Vercel/Render: https://your-domain.example
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon / Prisma (Vercel target)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Auth.js
AUTH_SECRET="generate-a-long-random-value"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Transactional password reset email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Ascend <noreply@your-domain.example>"
REQUIRE_EMAIL_VERIFICATION="false"

# Vercel Cron
CRON_SECRET="generate-another-random-value"

# Groq AI (server-side only)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# Pusher realtime guild channels
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# GitHub webhook and admin access
GITHUB_WEBHOOK_SECRET=""
ADMIN_EMAIL=""
